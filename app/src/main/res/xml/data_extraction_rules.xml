<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules to control what application data is backed up.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- In allowlist mode, only user settings from DataStore are backed up. Keystore-encrypted preferences and databases are excluded by default to prevent AEADBadTagException on restore. -->
        <include domain="file" path="datastore/"/>
    </cloud-backup>

    <device-transfer>
        <!-- In allowlist mode, only user settings from DataStore are transferred. Keystore-bound data is excluded by default. -->
        <include domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
