<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules to control what application data is backed up.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Keystore-encrypted preferences and database from cloud backup to prevent AEADBadTagException on restore -->
        <exclude domain="sharedpref" path="db_security_prefs.xml"/>
        <exclude domain="sharedpref" path="secure_auth_prefs.xml"/>
        <exclude domain="database" path="hometutorpro.db"/>

        <!-- Include user settings from DataStore -->
        <include domain="file" path="datastore/"/>
    </cloud-backup>

    <device-transfer>
        <!-- Exclude Keystore-encrypted preferences and database from device transfer as Keystore keys are device-bound -->
        <exclude domain="sharedpref" path="db_security_prefs.xml"/>
        <exclude domain="sharedpref" path="secure_auth_prefs.xml"/>
        <exclude domain="database" path="hometutorpro.db"/>
        <include domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
