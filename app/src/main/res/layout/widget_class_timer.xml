<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_brand_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="#818CF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_next_class_header"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- State 1: No Active Session -->
    <LinearLayout
        android:id="@+id/layout_no_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/widget_next_student_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_no_active_class"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_no_active_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_no_upcoming_class"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/btn_start_class"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/widget_button_start_bg"
            android:text="@string/widget_start_class"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- State 2: Active Session (Countdown Chronometer) -->
    <LinearLayout
        android:id="@+id/layout_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_active_student_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_active_time_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <Chronometer
                android:id="@+id/widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#10B981"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_chronometer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/widget_time_remaining"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_stop_class"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/widget_button_stop_bg"
            android:text="@string/widget_stop_class"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
